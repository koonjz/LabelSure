# LabelSure Web Dashboard — Environment Variables
#
# Copy to web_dashboard/.env.production (for production Netlify/Vercel builds)
# or web_dashboard/.env.local (for local overrides — gitignored).
#
# Only VITE_-prefixed variables are exposed to the browser.
# Do NOT put secrets here — this file is bundled into the JS.

# Backend API base URL (no trailing slash).
# Dev: leave this empty — the Vite dev proxy handles /api → localhost:8000
# Production: set to your deployed backend URL
VITE_API_URL=https://api.CHANGE_ME_YOUR_DOMAIN.app

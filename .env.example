# ─────────────────────────────────────────────────────────────────────────────
# LabelSure — Environment Variable Reference
#
# Copy this file to .env and fill in real values before running the app.
#   cp .env.example .env
#
# ⚠️  NEVER commit .env with real values.
#    .env is in .gitignore — .env.example is the only file that is committed.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Database ─────────────────────────────────────────────────────────────────

# Async PostgreSQL connection string for the FastAPI app.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# For local Docker Compose: postgresql+asyncpg://labelsure:YOURPASSWORD@db:5432/labelsure
# For a managed DB (Railway, Render, Supabase): copy the "asyncpg" connection string from their dashboard.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/labelsure

# Docker Compose postgres service settings (used by the 'db' container, NOT by asyncpg URL above)
POSTGRES_DB=labelsure
POSTGRES_USER=labelsure
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
# Port to expose PostgreSQL on the host (default 5432; change if port is already used)
POSTGRES_PORT=5432


# ─── Security ─────────────────────────────────────────────────────────────────

# JWT signing key. REQUIRED. Must be at least 32 characters and cryptographically random.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# Example output: 7f3a1b9e2d4c6a8f0e5b3c7d9a2f4e6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e8f
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_import_secrets_print_secrets.token_hex_32

# JWT algorithm — HS256 is the standard. No reason to change this unless you have HSM requirements.
ALGORITHM=HS256

# How long a login token stays valid, in minutes. 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ─── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins (no trailing slash).
# This MUST be set to your real frontend URL(s) in production.
# Wildcard "*" is only safe for local development.
#
# Examples:
#   Single frontend:    CORS_ORIGINS=https://dashboard.labelsure.app
#   Multiple frontends: CORS_ORIGINS=https://dashboard.labelsure.app,https://labelsure.app
#   Local dev only:     CORS_ORIGINS=*
CORS_ORIGINS=https://CHANGE_ME_YOUR_FRONTEND_DOMAIN.app


# ─── File Uploads ─────────────────────────────────────────────────────────────

# Directory where uploaded label images are stored.
# For Docker: use /app/uploads (mapped to a named volume).
# For bare-metal: use an absolute path, e.g. /var/labelsure/uploads
UPLOAD_DIR=uploads

# Maximum image size accepted (in MB). Images larger than this get HTTP 413.
MAX_UPLOAD_SIZE_MB=20


# ─── OCR / CV ─────────────────────────────────────────────────────────────────

# Minimum OCR confidence score (0–1) below which a scan is flagged NEEDS_REVIEW.
OCR_CONFIDENCE_THRESHOLD=0.70


# ─── App ──────────────────────────────────────────────────────────────────────

# Set to "false" in production.
# When false: Swagger UI (/docs), ReDoc (/redoc), and /openapi.json are hidden.
#             SQLAlchemy query echo is disabled.
DEBUG=false

# Application display name (cosmetic only)
APP_NAME=LabelSure

# Semantic version string (cosmetic only)
VERSION=1.0.0


# ─── Logging ──────────────────────────────────────────────────────────────────

# "json" → structured JSON logs for log aggregators (Datadog, Papertrail, Logtail, etc.)
# "text" → human-readable for local development
LOG_FORMAT=json


# ─── Workers ──────────────────────────────────────────────────────────────────

# Number of gunicorn worker processes.
# Rule of thumb: 2 × CPU_CORES + 1. Start with 2 for a 1-core VPS.
WORKERS=2


# ─── Rate Limiting ────────────────────────────────────────────────────────────

# Max login/register requests per IP per minute (brute-force protection)
RATE_LIMIT_AUTH_RPM=20

# Max scan upload requests per IP per minute
RATE_LIMIT_UPLOAD_RPM=30

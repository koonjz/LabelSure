# LabelSure — Environment Variables
# Copy to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://labelsure:labelsure@localhost:5432/labelsure
SYNC_DATABASE_URL=postgresql://labelsure:labelsure@localhost:5432/labelsure

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changeme-use-a-long-random-secret-in-production

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# OCR
OCR_CONFIDENCE_THRESHOLD=0.70

# App
APP_NAME=LabelSure
VERSION=1.0.0
DEBUG=true

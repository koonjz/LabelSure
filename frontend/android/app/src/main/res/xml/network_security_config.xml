<?xml version="1.0" encoding="utf-8"?>
<!--
  LabelSure - Network Security Configuration
  Allows plaintext HTTP to local/emulator backend addresses (DEV ONLY).
  Replace with HTTPS endpoint before production release.
-->
<network-security-config>

    <!-- Base config: trust system CAs only, no cleartext for other hosts -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- DEV ONLY: allow cleartext for local/emulator addresses -->

    <!-- Android emulator to host machine -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Genymotion emulator to host machine -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>

    <!-- Local loopback fallback -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!--
      Physical device on same LAN as dev machine.
      Note: Android network-security-config does NOT support CIDR notation.
      Add your dev machine IP manually if outside 192.168.x.x range.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Matches any host ending in .local (mDNS) -->
        <domain includeSubdomains="true">.local</domain>
    </domain-config>

</network-security-config>
